# Supabase — vedi Project Settings > API sul progetto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
# Mai esporre con prefisso NEXT_PUBLIC_: usata solo server-side (lib/supabase/service-role.ts)
# per operazioni privilegiate (RPC Vault credenziali portali).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Anthropic API — non ancora usata in Fase 1, servirà per il parsing PDF/OCR
# nelle fasi successive (letture E-distribuzione, onboarding licenza).
ANTHROPIC_MODEL=claude-3-5-sonnet
ANTHROPIC_API_KEY=sk-ant-...

# Email transazionali (F24, registro letture, protocollo dichiarazione) via
# SMTP — compatibile con qualunque provider. L'utente userà Brevo: host tipo
# smtp-relay.brevo.com, porta 587, user/password dalla sezione SMTP & API di
# Brevo (non è la stessa chiave dell'API REST).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=...
SMTP_PASSWORD=...
# Mittente mostrato al cliente; se omesso si usa SMTP_USER.
EMAIL_FROM="Paolo Rinaldin <info@example.com>"

# Nota: VERCEL_ENV NON va impostata qui né nel Project Settings di Vercel:
# è una variabile di sistema che la piattaforma inietta automaticamente ad
# ogni deploy (production/preview/development). Vercel rifiuta un tentativo
# di impostarla manualmente.
